<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.brunojaegerk</groupId>
    <artifactId>auctionhouse</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>AuctionHouse</name>
    <description>Casa de subastas para NukkitPetteriM1Edition</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <repositories>
        <repository>
            <id>luminiadev-releases</id>
            <url>https://repo.luminiadev.com/releases</url>
        </repository>

        <repository>
            <id>nukkitx-snapshots</id>
            <url>https://repo.nukkitx.com/snapshot</url>
        </repository>

        <repository>
            <id>opencollab-releases</id>
            <url>https://repo.opencollab.dev/maven-releases/</url>
        </repository>

        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>

        <!-- NukkitPetteriM1Edition -->
        <dependency>
            <groupId>cn.nukkit</groupId>
            <artifactId>Nukkit</artifactId>
            <version>PM1E</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/server.jar</systemPath>
        </dependency>

        <!-- FakeInventories -->
        <dependency>
            <groupId>me.iwareq</groupId>
            <artifactId>FakeInventories</artifactId>
            <version>1.1.8-PM1E-IWareQ</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/FakeInventories-1.1.8-PM1E-IWareQ.jar</systemPath>
        </dependency>

        <!-- FormConstructor 3.1.0 -->
        <dependency>
            <groupId>com.mefrreex.formconstructor</groupId>
            <artifactId>formconstructor</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- EconomyAPI 2.0.7 -->
        <dependency>
            <groupId>me.onebone</groupId>
            <artifactId>economyapi</artifactId>
            <version>2.0.7</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/economyapi-2.0.7.jar</systemPath>
        </dependency>

        <!-- SQLite JDBC aislado dentro del plugin -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.0.0</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>AuctionHouse-${project.version}</finalName>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>

            <!-- Empaquetar y aislar SQLite JDBC -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- No empaquetar dependencias proporcionadas por el servidor -->
                            <artifactSet>
                                <excludes>
                                    <exclude>cn.nukkit:Nukkit</exclude>
                                    <exclude>me.iwareq:FakeInventories</exclude>
                                    <exclude>me.onebone:economyapi</exclude>
                                    <exclude>com.mefrreex.formconstructor:formconstructor</exclude>
                                </excludes>
                            </artifactSet>

                            <!-- Reubicar las clases SQLite -->
                            <relocations>
                                <relocation>
                                    <pattern>org.sqlite</pattern>
                                    <shadedPattern>com.brunojaegerk.auctionhouse.libs.sqlite</shadedPattern>
                                </relocation>
                            </relocations>

                            <!-- Conservar el registro automático del controlador JDBC -->
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>

                            <!-- Eliminar firmas antiguas -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>


